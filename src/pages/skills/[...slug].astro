---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { skillMeta } from '../../../site.config';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return skills.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const meta = skillMeta[entry.id];
const displayName = meta?.display || entry.data.name;
---

<Base title={displayName}>
  <div class="container-prose">
    <Breadcrumb items={[
      { label: '技能箱', href: '/skills/' },
      { label: displayName },
    ]} />

    <PageHeader
      kicker={`SKILL · ${entry.id}`}
      title={displayName}
      meta={[
        meta?.repo ? `来自 ${meta.repo}` : '',
        meta?.module ? `关联模块 ${meta.module}` : '',
      ].filter(Boolean)}
    />

    {entry.data.description && (
      <p class="skill-description">{entry.data.description}</p>
    )}

    <article class="prose" data-pagefind-meta="collection:技能箱">
      <Fragment set:html={entry.data.body} />
    </article>
  </div>
</Base>

<style>
  .skill-description {
    font-size: var(--fs-body);
    color: var(--gray-700);
    line-height: var(--lh-body);
    margin-bottom: var(--sp-4);
    padding: var(--sp-3);
    background: var(--paper-2);
    border-radius: var(--radius);
  }
</style>
