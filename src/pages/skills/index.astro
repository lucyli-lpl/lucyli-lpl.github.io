---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import EmptyState from '../../components/EmptyState.astro';
import Accordion from '../../components/Accordion.astro';
import { skillMeta } from '../../../site.config';

const allSkills = await getCollection('skills');
const modules = await getCollection('methodology');
const moduleByOrder = new Map(modules.map(m => [String(m.data.order).padStart(2, '0'), m]));
const tastings = await getCollection('tastings');
const patterns = await getCollection('patterns');

// 站内由该 skill 产出的内容（按仓库/用途粗略映射）
function outputsOf(id: string): { title: string; href: string }[] {
  if (id === 'ai-product-tasting') return tastings.map(t => ({ title: `${t.data.product} 品鉴`, href: `/tastings/${t.id}/` }));
  if (id === 'pattern-tracker') return patterns.map(p => ({ title: `${p.data.pattern_name} ${p.data.chinese_name}`, href: `/patterns/${p.id}/` }));
  return [];
}

const firstSentence = (s: string) => s.split(/(?<=[。！？.!?])\s*/)[0] ?? s;
---

<Base title="技能箱">
  <div class="container-wide">
    <SectionIntro
      kicker="SKILLS"
      title="技能箱"
      subtitle="可直接调用的认知模块。每个 skill 是一套写进 SKILL.md 的分析流程，装进 Claude 就能用。"
      meta={[`${allSkills.length} 个 skill`]}
      hand="Recipes, not tools."
    />

    {allSkills.length === 0 ? (
      <EmptyState title="技能箱" description="正在整理" />
    ) : (
      <div class="drawer-list">
        {allSkills.map((s, i) => {
          const meta = skillMeta[s.id];
          const displayName = meta?.display || s.data.name;
          const mod = meta?.module ? moduleByOrder.get(meta.module) : undefined;
          const outputs = outputsOf(s.id);
          return (
            <Accordion id={`skill-${s.id}`} variant="plain" open={i === 0}>
              <Fragment slot="summary">
                <div class="drawer-summary">
                  <span class="drawer-idx">{String(i + 1).padStart(2, '0')}</span>
                  <div class="drawer-text">
                    <span class="drawer-name">{displayName}<span class="drawer-slug">{s.id}</span></span>
                    {s.data.description && <span class="drawer-line">{firstSentence(s.data.description)}</span>}
                  </div>
                </div>
              </Fragment>

              <div class="drawer-body">
                <dl class="drawer-facts">
                  {meta?.repo && <><dt>来源</dt><dd><a href={`https://github.com/lucyli-lpl/${meta.repo}/tree/main/skills/${s.id}`} target="_blank" rel="noopener">{meta.repo} ↗</a></dd></>}
                  {mod && <><dt>方法论</dt><dd><a href={`/methodology/${mod.id}/`}>{meta!.module} {mod.data.title}</a></dd></>}
                  <dt>站内产出</dt>
                  <dd>
                    {outputs.length ? (
                      <ul class="drawer-outputs">{outputs.map(o => <li><a href={o.href}>{o.title}</a></li>)}</ul>
                    ) : <span class="drawer-muted">尚无</span>}
                  </dd>
                </dl>
                <a href={`/skills/${s.id}/`} class="drawer-cta">查看 skill →</a>
              </div>
            </Accordion>
          );
        })}
      </div>
    )}
  </div>
</Base>

<style>
  .drawer-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .drawer-summary {
    display: grid;
    grid-template-columns: 2.4em 1fr;
    gap: var(--sp-2);
    align-items: baseline;
  }

  .drawer-idx {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--gold);
    letter-spacing: .08em;
  }

  .drawer-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .drawer-name {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    color: var(--ink);
    display: flex;
    align-items: baseline;
    gap: var(--sp-1);
    flex-wrap: wrap;
  }

  .drawer-slug {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    font-weight: 400;
    color: var(--text-3);
  }

  .drawer-line {
    font-size: var(--fs-small);
    color: var(--text-2);
    line-height: 1.6;
  }

  .drawer-body {
    padding-left: calc(2.4em + var(--sp-2));
    padding-top: var(--sp-2);
    margin-top: var(--sp-1);
    border-top: 1px dashed var(--silver-light);
  }

  .drawer-facts {
    display: grid;
    grid-template-columns: 5em 1fr;
    gap: 6px var(--sp-2);
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-small);
  }

  .drawer-facts dt {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--text-3);
    padding-top: 3px;
  }

  .drawer-facts dd { margin: 0; color: var(--text-2); }
  .drawer-facts a { color: var(--ink); }
  .drawer-facts a:hover { color: var(--blue); }

  .drawer-outputs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: .4em .8em;
  }

  .drawer-muted { color: var(--text-3); }

  .drawer-cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--paper-white);
    background: var(--ink);
    padding: .5em 1em;
    border-radius: var(--radius);
  }

  .drawer-cta:hover { background: var(--ink-2); }

  @media (max-width: 767px) {
    .drawer-body { padding-left: 0; }
  }
</style>
