---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import { skillMeta } from '../../../site.config';

const allSkills = await getCollection('skills');
---

<Base title="工具箱">
  <div class="container-wide">
    <PageHeader
      kicker="SKILLS"
      title="工具箱"
      subtitle="可复用的 AI 产品分析技能"
      meta={[`${allSkills.length} 个 skill`]}
    />

    {allSkills.length === 0 ? (
      <EmptyState title="工具箱 · 筹备中" description="尚无 skill 内容" />
    ) : (
      <div class="skill-grid">
        {allSkills.map(s => {
          const meta = skillMeta[s.id];
          const displayName = meta?.display || s.data.name;
          return (
            <a href={`/skills/${s.id}/`} class="skill-card">
              <h3 class="skill-name">{displayName}</h3>
              <p class="skill-id">{s.id}</p>
              {s.data.description && (
                <p class="skill-desc">{s.data.description.slice(0, 120)}{s.data.description.length > 120 ? '…' : ''}</p>
              )}
              {meta?.repo && <span class="skill-repo">{meta.repo}</span>}
            </a>
          );
        })}
      </div>
    )}
  </div>
</Base>

<style>
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
  }

  @media (max-width: 640px) {
    .skill-grid {
      grid-template-columns: 1fr;
    }
  }

  .skill-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--sp-3);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.1s;
  }

  .skill-card:hover {
    border-color: var(--ink);
  }

  .skill-name {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: 0.25em;
  }

  .skill-id {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--gray-500);
    margin-bottom: var(--sp-1);
  }

  .skill-desc {
    font-size: var(--fs-meta);
    color: var(--gray-700);
    line-height: var(--lh-body);
    margin-bottom: var(--sp-1);
  }

  .skill-repo {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--gray-500);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    padding: 1px 6px;
  }
</style>
