---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import Verdict from '../../components/Verdict.astro';
import Tag from '../../components/Tag.astro';
import RelatedEntries from '../../components/RelatedEntries.astro';

export async function getStaticPaths() {
  const tastings = await getCollection('tastings');
  return tastings.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { product, company, product_launched, analyzed, verdict, patterns, tags, chapters, framework, framework_version } = entry.data;
const allPatterns = await getCollection('patterns');
const linkedPatterns = (patterns || []).map(p => {
  const found = allPatterns.find(x => x.id === p || x.data.pattern_name.toLowerCase() === p.toLowerCase());
  return { title: found ? `${found.data.pattern_name} ${found.data.chinese_name}` : p, href: found ? `/patterns/${found.id}/` : `/patterns/`, hint: found ? undefined : '未收录' };
});

const headings = chapters.map((ch, i) => ({
  slug: `ch-${String(i + 1).padStart(2, '0')}`,
  text: `${String(i + 1).padStart(2, '0')}. ${ch.title}`,
  depth: 2,
}));
---

<Base title={`${product} 品鉴`}>
  <div class="layout-sidebar">
    <div class="main-content">
      <Breadcrumb items={[
        { label: '品鉴', href: '/tastings/' },
        { label: product },
      ]} />

      <ArticleHeader
        kicker={`TASTING · ${company}`}
        title={product}
        meta={[
          product_launched ? `上线 ${product_launched}` : '',
          analyzed ? `品鉴 ${analyzed}` : '',
          `${chapters.length} 章`,
        ]}
      />

      <Verdict text={verdict} />

      {(tags || []).length > 0 && (
        <div class="tags-row">{(tags || []).map(t => <Tag label={t} />)}</div>
      )}

      <article class="prose" data-pagefind-meta="collection:产品品鉴">
        {chapters.map((ch, i) => {
          const chNum = String(i + 1).padStart(2, '0');
          return (
            <section>
              <h2 id={`ch-${chNum}`}>{chNum}. {ch.title}</h2>
              <Fragment set:html={ch.body} />
            </section>
          );
        })}
      </article>

      <RelatedEntries groups={[
        { label: '关联 pattern', items: linkedPatterns },
        { label: '使用框架', items: framework ? [{ title: `${framework}${framework_version ? ` v${framework_version}` : ''}`, href: '/skills/ai-product-tasting/' }] : [] },
      ]} />
    </div>

    <aside class="sidebar">
      <ChapterNav headings={headings} />
    </aside>
  </div>
</Base>

<style>
  .tags-row {
    display: flex;
    gap: 0.5em;
    flex-wrap: wrap;
    margin-bottom: var(--sp-4);
  }

  .sidebar { order: 1; }

  @media (max-width: 900px) {
    .sidebar { order: -1; }
  }
</style>
