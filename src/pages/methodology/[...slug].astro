---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import KeyClaim from '../../components/KeyClaim.astro';
import GrowthLog from '../../components/GrowthLog.astro';
import RelatedEntries from '../../components/RelatedEntries.astro';
import { loadChangelog, entriesForModule } from '../../lib/changelog';
import { skillMeta } from '../../../site.config';

export async function getStaticPaths() {
  const modules = await getCollection('methodology');
  const sorted = modules.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? sorted[i - 1] : null,
      next: i < sorted.length - 1 ? sorted[i + 1] : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { order, title, one_liner, chapters, skills, since_version, hasDiagram, slug } = entry.data;
const orderStr = String(order).padStart(2, '0');
const growth = entriesForModule(loadChangelog(), order);
const relatedRetros = (await getCollection('retros'))
  .filter(r => r.data.affected_modules.includes(order))
  .sort((a, b) => (b.data.updated || '').localeCompare(a.data.updated || ''));

const headings = chapters.map((ch, i) => ({
  slug: `ch-${String(i + 1).padStart(2, '0')}`,
  text: `${String(i + 1).padStart(2, '0')}. ${ch.title}`,
  depth: 2,
}));
---

<Base title={`${orderStr}. ${title}`}>
  <div class="layout-sidebar">
    <div class="main-content">
      <Breadcrumb items={[
        { label: '方法论', href: '/methodology/' },
        { label: title },
      ]} />

      <ArticleHeader
        kicker={`MODULE ${orderStr}`}
        title={title}
        meta={[
          `${chapters.length} 章`,
          since_version ? `v${since_version} 起` : '',
          growth.length ? `${growth.length} 次修订` : '',
        ]}
      />

      {one_liner && <KeyClaim label="核心命题" text={one_liner} />}

      {hasDiagram && (
        <figure class="module-diagram paper-card">
          <img src={`/content/methodology/${slug}/diagram.svg`} alt={`${title} 示意图`} loading="lazy" />
        </figure>
      )}

      <article class="prose" data-pagefind-meta={`collection:方法论`}>
        {chapters.map((ch, i) => {
          const chNum = String(i + 1).padStart(2, '0');
          return (
            <section>
              <h2 id={`ch-${chNum}`}>{chNum}. {ch.title}</h2>
              <Fragment set:html={ch.body} />
            </section>
          );
        })}
      </article>

      <RelatedEntries groups={[
        { label: '关联 skill', items: skills.map(s => ({ title: skillMeta[s]?.display ?? s, href: `/skills/${s}/`, hint: s })) },
        { label: '相关复盘', items: relatedRetros.map(r => ({ title: r.data.title, href: `/retros/${r.id}/`, hint: r.data.pitfalls.filter(p => p.module === order).length ? `${r.data.pitfalls.filter(p => p.module === order).length} 个坑` : undefined })) },
      ]} />

      <nav class="module-nav" aria-label="上一个 / 下一个模块">
        {prev && (
          <a href={`/methodology/${prev.id}/`} class="nav-prev">
            <span class="nav-label">上一模块</span>
            {String(prev.data.order).padStart(2, '0')}. {prev.data.title}
          </a>
        )}
        <span class="nav-spacer" />
        {next && (
          <a href={`/methodology/${next.id}/`} class="nav-next">
            <span class="nav-label">下一模块</span>
            {String(next.data.order).padStart(2, '0')}. {next.data.title}
          </a>
        )}
      </nav>
    </div>

    <aside class="sidebar">
      <ChapterNav headings={headings} />
      <GrowthLog entries={growth} />
    </aside>
  </div>
</Base>

<style>
  .module-diagram {
    margin-bottom: var(--sp-4);
    padding: var(--sp-3);
  }

  .module-diagram img {
    width: 100%;
    height: auto;
  }

  .module-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line-soft);
  }

  .nav-prev, .nav-next {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--fs-small);
    color: var(--ink);
    max-width: 46%;
  }

  .nav-next { text-align: right; }

  .nav-label {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--text-3);
    letter-spacing: .08em;
  }

  .nav-prev:hover, .nav-next:hover { color: var(--blue); }

  .nav-spacer { flex: 1; }

  .sidebar { order: 1; }

  @media (max-width: 900px) {
    .sidebar { order: -1; }
  }
</style>
