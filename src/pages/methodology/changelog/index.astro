---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { loadChangelog, TRIGGER_META } from '../../../lib/changelog';

// 页面按 新 → 旧 展示
const entries = loadChangelog().reverse();
---

<Base title="方法论迭代记录">
  <div class="container-prose">
    <Breadcrumb items={[
      { label: '方法论', href: '/methodology/' },
      { label: '迭代记录' },
    ]} />

    <PageHeader
      kicker="CHANGELOG"
      title="方法论迭代记录"
      subtitle="从 v1 到最新版本的演进脉络"
      meta={[`${entries.length} 个版本`]}
    />

    <div class="changelog">
      {entries.map(entry => (
        <article class="version-entry" id={`v${entry.version}`}>
          <div class="version-header">
            <span class="version-tag">v{entry.version}</span>
            {entry.date && <span class="version-date">{entry.date}</span>}
            {entry.retro ? (
              <a href={`/retros/${entry.retro}/`} class={`version-trigger version-trigger--${entry.trigger}`} title="查看复盘">
                {TRIGGER_META[entry.trigger].glyph} {TRIGGER_META[entry.trigger].label}
                <span class="version-trigger-ref">· {entry.trigger_ref ?? entry.retro} →</span>
              </a>
            ) : (
              <span class={`version-trigger version-trigger--${entry.trigger}`} title="触发源">
                {TRIGGER_META[entry.trigger].glyph} {TRIGGER_META[entry.trigger].label}
                {entry.trigger_ref && <span class="version-trigger-ref">· {entry.trigger_ref}</span>}
              </span>
            )}
            <span class="version-modules">
              模块 {entry.modules.join(', ')}
            </span>
          </div>
          <p class="version-summary">{entry.summary}</p>
          {entry.details && <div class="version-details">
            {entry.details.trim().split('\n').map(line => (
              <p>{line}</p>
            ))}
          </div>}
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .changelog {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .version-entry {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--sp-3);
    scroll-margin-top: var(--sp-6);
  }

  .version-entry:target {
    border-color: var(--ink);
  }

  a.version-trigger { text-decoration: none; }
  a.version-trigger:hover { text-decoration: underline; }

  .version-trigger {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    padding: 2px 8px;
    border-radius: var(--radius);
    background: var(--gray-100);
    color: var(--gray-700);
  }

  .version-trigger--project    { background: var(--warm-light);   color: var(--warm); }
  .version-trigger--reading    { background: var(--accent-light); color: var(--accent); }
  .version-trigger--discussion { background: var(--green-light);  color: var(--green); }

  .version-trigger-ref {
    color: inherit;
    opacity: 0.8;
  }

  .version-header {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
  }

  .version-tag {
    font-family: var(--font-mono);
    font-size: var(--fs-body);
    font-weight: 700;
    background: var(--ink);
    color: var(--paper);
    padding: 2px 10px;
    border-radius: var(--radius);
  }

  .version-date {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--gray-500);
  }

  .version-modules {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--gray-500);
    margin-left: auto;
  }

  .version-summary {
    font-weight: 600;
    margin-bottom: var(--sp-2);
  }

  .version-details p {
    font-size: var(--fs-meta);
    color: var(--gray-700);
    line-height: var(--lh-body);
    margin-bottom: 0.25em;
  }
</style>
