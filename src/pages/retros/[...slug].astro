---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import Tag from '../../components/Tag.astro';
import PitfallCard from '../../components/PitfallCard.astro';

export async function getStaticPaths() {
  const retros = await getCollection('retros');
  return retros.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const {
  title, project, period, status, affected_modules, produced_version,
  tags, updates, updated, chapters, summary, pitfalls,
} = entry.data;

const modules = await getCollection('methodology');
const moduleById = new Map(modules.map(m => [m.data.order, m]));
const linkedModules = affected_modules
  .map(o => moduleById.get(o))
  .filter((m): m is NonNullable<typeof m> => Boolean(m))
  .sort((a, b) => a.data.order - b.data.order);

const headings = chapters.map((ch, i) => ({
  slug: `ch-${String(i + 1).padStart(2, '0')}`,
  text: `${String(i + 1).padStart(2, '0')}. ${ch.title}`,
  depth: 2,
}));

const isPitfallChapter = (slug: string) => /pitfall|坑/i.test(slug);
---

<Base title={`${title} · 复盘`}>
  <div class="layout-sidebar">
    <div class="main-content">
      <Breadcrumb items={[
        { label: '复盘', href: '/retros/' },
        { label: title },
      ]} />

      <ArticleHeader
        kicker={`RETRO${project ? ` · ${project}` : ''}`}
        title={title}
        meta={[
          period ?? '',
          status === 'ongoing' ? '进行中' : '已封版',
          updated ? `更新 ${updated}` : '',
          `${chapters.length} 章`,
        ].filter(Boolean)}
      />

      {summary && (
        <aside class="key-claim key-claim--gold retro-lead">
          <span class="section-num">LEARNING SHIFT</span>
          <Fragment set:html={summary.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
        </aside>
      )}

      {(linkedModules.length > 0 || produced_version) && (
        <div class="link-strip">
          <span class="strip-label">打通方法论</span>
          {linkedModules.map(m => (
            <Tag label={`${String(m.data.order).padStart(2, '0')} ${m.data.title}`} href={`/methodology/${m.id}/`} />
          ))}
          {produced_version && (
            <a href={`/methodology/changelog/#v${produced_version}`} class="version-link">推动 v{produced_version}</a>
          )}
        </div>
      )}

      {tags.length > 0 && (
        <div class="tags-row">{tags.map(t => <Tag label={t} />)}</div>
      )}

      <article class="prose" data-pagefind-meta="collection:项目复盘">
        {chapters.map((ch, i) => {
          const chNum = String(i + 1).padStart(2, '0');
          const usePitfallCards = isPitfallChapter(ch.slug) && pitfalls.length > 0;
          return (
            <section>
              <h2 id={`ch-${chNum}`}>{chNum}. {ch.title}</h2>
              {usePitfallCards ? (
                <div class="pitfall-list not-prose">
                  {pitfalls.map(p => {
                    const m = p.module != null ? moduleById.get(p.module) : undefined;
                    return (
                      <PitfallCard
                        what={p.what} why={p.why} fix={p.fix}
                        module={p.module}
                        moduleTitle={m?.data.title}
                        moduleHref={m ? `/methodology/${m.id}/` : undefined}
                      />
                    );
                  })}
                </div>
              ) : (
                <Fragment set:html={ch.body} />
              )}
            </section>
          );
        })}
      </article>
    </div>

    <aside class="sidebar">
      <ChapterNav headings={headings} />
      {updates.length > 0 && (
        <div class="update-trail">
          <p class="sidebar-label">更新轨迹 · {updates.length} 次</p>
          <ol class="trail-list">
            {[...updates].reverse().map(u => (
              <li>
                <span class="trail-date">{u.date}</span>
                <span class="trail-note">{u.note}</span>
              </li>
            ))}
          </ol>
        </div>
      )}
    </aside>
  </div>
</Base>

<style>
  .retro-lead {
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--radius-lg);
    background: var(--paper-white);
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--gold);
    margin-bottom: var(--sp-3);
  }

  .retro-lead .section-num { display: block; margin-bottom: var(--sp-1); }

  .retro-lead :global(p) {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.7;
    color: var(--ink);
  }

  .retro-lead :global(p + p) { margin-top: 0.5em; }

  .link-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    padding: var(--sp-2) var(--sp-3);
    background: var(--paper-2);
    border-radius: var(--radius);
    margin-bottom: var(--sp-2);
  }

  .strip-label {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--gray-500);
    letter-spacing: 0.08em;
    margin-right: var(--sp-1);
  }

  .version-link {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--paper);
    background: var(--ink);
    padding: 2px 10px;
    border-radius: var(--radius);
    text-decoration: none;
  }

  .tags-row {
    display: flex;
    gap: 0.5em;
    flex-wrap: wrap;
    margin-bottom: var(--sp-4);
  }

  .pitfall-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-bottom: var(--sp-4);
  }

  .sidebar { order: 1; }

  .update-trail { margin-top: var(--sp-4); }

  .sidebar-label {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--gray-500);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--sp-1);
  }

  .trail-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--gray-200);
  }

  .trail-list li {
    padding-left: var(--sp-2);
    margin-bottom: var(--sp-1);
    font-size: var(--fs-meta);
    line-height: 1.5;
  }

  .trail-date {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--gray-500);
  }

  .trail-note { color: var(--gray-700); }

  @media (max-width: 900px) {
    .sidebar { order: -1; }
  }
</style>
