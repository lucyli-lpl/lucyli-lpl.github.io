---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionIntro from '../../components/SectionIntro.astro';

const patterns = await getCollection('patterns');
const tastings = await getCollection('tastings');
const anatomies = await getCollection('anatomies');

const folders = [
  { num: '01', title: 'Pattern 追踪', sub: 'Patterns', href: '/patterns/', count: patterns.length, unit: '个 pattern', desc: '按能力模式而非公司追踪 AI 产品设计趋势：谁先做的、谁跟进了、取舍有何不同、如何演化。', latest: patterns.map(p => `${p.data.pattern_name} ${p.data.chinese_name}`) },
  { num: '02', title: '产品品鉴', sub: 'Tastings', href: '/tastings/', count: tastings.length, unit: '篇', desc: '用固定框架深度拆解一个 AI 产品：为什么做、怎么做的、交互如何、格局如何。', latest: tastings.map(t => t.data.product) },
  { num: '03', title: '公司拆解', sub: 'Anatomies', href: '/anatomies/', count: anatomies.length, unit: '篇', desc: '从招股书等公开材料拆解 AI 公司的商业结构。', latest: anatomies.map(a => a.data.company) },
];
---

<Base title="观察">
  <div class="container-wide">
    <SectionIntro
      kicker="OBSERVATIONS"
      title="观察"
      subtitle="三个档案夹：设计模式的演化、具体产品的深度品鉴、公司的商业拆解。"
      meta={[`${patterns.length + tastings.length + anatomies.length} 条记录`]}
      hand="Same world, new angle."
    />

    <div class="folders">
      {folders.map((f, i) => (
        <a href={f.href} class:list={['folder', 'paper-card', 'lift', { 'folder--empty': f.count === 0 }]} style={`--i:${i}`}>
          <span class="folder-tab"><span class="folder-num">{f.num}</span>{f.sub}</span>
          <div class="folder-body">
            <h2 class="folder-title">{f.title}</h2>
            <p class="folder-desc">{f.desc}</p>
            <div class="folder-foot">
              <span class="folder-count">{f.count} {f.unit}</span>
              {f.latest.length > 0 && <span class="folder-latest">{f.latest.slice(0, 3).join(' · ')}</span>}
              {f.count === 0 && <span class="folder-latest">正在整理</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .folders {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    gap: var(--sp-3);
    align-items: start;
  }

  .folder {
    position: relative;
    display: block;
    color: var(--ink);
    margin-top: calc(var(--i) * var(--sp-2)); /* 错位层叠 */
    padding-top: var(--sp-2);
  }

  .folder--empty {
    opacity: .75;
  }

  /* 文件夹标签 */
  .folder-tab {
    position: absolute;
    top: -14px;
    left: var(--sp-3);
    display: inline-flex;
    align-items: baseline;
    gap: .5em;
    padding: 3px 12px;
    background: var(--paper-2);
    border: 1px solid var(--line-soft);
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--text-2);
    letter-spacing: .06em;
  }

  .folder-num { color: var(--gold); }

  .folder-body {
    padding: var(--sp-3) var(--sp-3) var(--sp-3);
  }

  .folder-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: var(--sp-1);
  }

  .folders > .folder:first-child .folder-title { font-size: 1.75rem; }

  .folder-desc {
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--text-2);
    margin-bottom: var(--sp-2);
  }

  .folder-foot {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-3);
    border-top: 1px solid var(--line-soft);
    padding-top: var(--sp-1);
  }

  .folder-count { color: var(--ink); }

  @media (max-width: 900px) {
    .folders {
      display: flex;
      gap: var(--sp-2);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding: var(--sp-2) 0 var(--sp-2);
      margin: 0 calc(-1 * var(--sp-2));
      padding-left: var(--sp-2);
    }
    .folders::-webkit-scrollbar { display: none; }
    .folder { flex: 0 0 82vw; scroll-snap-align: start; margin-top: var(--sp-2); }
    .folders > .folder:last-child { margin-right: var(--sp-2); }
  }
</style>
