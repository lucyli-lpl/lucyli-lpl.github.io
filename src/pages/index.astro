---
import Base from '../layouts/Base.astro';
import ArchiveNote from '../components/ArchiveNote.astro';
import { archiveNotes, currentFocus, featuredEntries } from '../../site.config';

const [primary, ...secondary] = featuredEntries;
const noteLayout: Record<string, { area: string; size: 'lg' | 'md'; rotate: number }> = {
  methodology:  { area: 'meth',   size: 'lg', rotate: -1.1 },
  observations: { area: 'obs',    size: 'md', rotate: 1.3 },
  skills:       { area: 'skill',  size: 'md', rotate: -0.6 },
  presets:      { area: 'visual', size: 'md', rotate: 0.9 },
  notes:        { area: 'notes',  size: 'md', rotate: -0.4 },
};
---

<Base title="首页" footer="compact">
  <!-- ========== A. Hero / Knowledge Desk ========== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="photo-layer hero-photo">
      <picture>
        <source media="(max-width: 767px)" srcset="/img/board-wall-wide-800.webp" />
        <img src="/img/board-wall-wide-1440.webp" alt="" width="1440" height="810" fetchpriority="high" decoding="async" />
      </picture>
    </div>

    <div class="container-hero hero-grid">
      <div class="hero-copy">
        <p class="kicker reveal">A quieter mind · A brighter you</p>
        <h1 id="hero-title" class="hero-title reveal" data-delay="1">让学习和实践沉淀为方法，<br/>构建更清晰的思考体系。</h1>
        <p class="hero-sub reveal" data-delay="2">一线企业 AI PM 的实践方法论、产品观察与工具沉淀。从能力边界出发，把项目里踩过的坑，反向修订成方法的下一个版本。</p>
        <div class="hero-actions reveal" data-delay="3">
          <a href="/methodology/" class="btn btn--primary">进入知识地图</a>
          <a href="#featured" class="btn btn--ghost">查看最近更新</a>
        </div>
        <span class="hand hero-hand" aria-hidden="true">Small progress, big change.</span>
      </div>

      <div class="research-board" data-board>
        {archiveNotes.map((n, i) => (
          <ArchiveNote
            title={n.title}
            sub={n.sub}
            desc={n.desc}
            href={n.href}
            icon={n.icon}
            size={noteLayout[n.key].size}
            rotate={noteLayout[n.key].rotate}
            area={noteLayout[n.key].area}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ========== B. 正在沉淀 + 精选内容 ========== -->
  <section class="desk container-wide" id="featured" aria-label="正在沉淀与精选内容">
    <aside class="focus reveal">
      <p class="section-num">CURRENT FOCUS</p>
      <h2 class="focus-title">正在沉淀</h2>
      <ol class="focus-list">
        {currentFocus.map((f, i) => (
          <li class="focus-item">
            <span class="focus-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="focus-name">{f.title}</p>
              <p class="focus-q">{f.question}</p>
            </div>
          </li>
        ))}
      </ol>
    </aside>

    <div class="featured">
      <p class="section-num">FEATURED</p>
      <h2 class="featured-title">精选内容</h2>

      <div class="featured-grid">
        <a href={primary.href} class="feat feat--primary paper-card lift reveal">
          {'image' in primary && primary.image && (
            <figure class="feat-figure">
              <img src={primary.image} alt={primary.imageAlt ?? ''} loading="lazy" decoding="async" />
            </figure>
          )}
          <div class="feat-body">
            <span class="feat-kicker">{primary.kicker}</span>
            <h3 class="feat-name">{primary.title}</h3>
            <p class="feat-summary">{primary.summary}</p>
            <span class="feat-more">阅读 →</span>
          </div>
        </a>

        <div class="feat-side">
          {secondary.map((e, i) => (
            <a href={e.href} class="feat feat--secondary paper-card lift reveal" data-delay={String(i + 1)}>
              <span class="feat-kicker">{e.kicker}</span>
              <h3 class="feat-name">{e.title}</h3>
              <p class="feat-summary">{e.summary}</p>
              <span class="feat-more">阅读 →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // 细指针设备：便签随指针轻微倾斜（≤ 2deg）；reduced-motion / 触屏不启用
  function initTilt() {
    const fine = matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine) return;
    document.querySelectorAll<HTMLElement>('[data-tilt]:not([data-tilt-bound])').forEach(el => {
      el.dataset.tiltBound = '1';
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - .5;
        const py = (e.clientY - r.top) / r.height - .5;
        el.style.setProperty('--ty', `${(px * 4).toFixed(2)}deg`);
        el.style.setProperty('--tx', `${(-py * 4).toFixed(2)}deg`);
      });
      el.addEventListener('pointerleave', () => {
        el.style.setProperty('--tx', '0deg');
        el.style.setProperty('--ty', '0deg');
      });
    });
  }
  initTilt();
  document.addEventListener('astro:page-load', initTilt);
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--sp-6) 0 var(--sp-5);
    min-height: 640px;
    display: flex;
    align-items: center;
  }

  .hero-photo img {
    object-position: 68% 40%;
    opacity: .9;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: 44fr 56fr;
    gap: var(--sp-6);
    align-items: center;
  }

  .hero-copy {
    position: relative;
    max-width: 560px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -.01em;
    margin: var(--sp-2) 0 var(--sp-3);
    color: var(--ink);
  }

  .hero-sub {
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--text-2);
    max-width: 44ch;
    margin-bottom: var(--sp-4);
  }

  .hero-actions {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 500;
    padding: .7em 1.5em;
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition: transform var(--dur-fast) var(--ease-standard), background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
  }

  .btn--primary {
    background: var(--ink);
    color: var(--paper-white);
  }

  .btn--primary:hover {
    background: var(--ink-2);
    transform: translateY(-1px);
  }

  .btn--ghost {
    color: var(--ink);
    border-color: var(--line);
    background: var(--glass-bg-hi);
  }

  .btn--ghost:hover {
    border-color: var(--ink);
  }

  .hero-hand {
    display: block;
    margin-top: var(--sp-4);
    margin-left: var(--sp-1);
  }

  /* ---------- Research board ---------- */
  .research-board {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      'meth meth obs'
      'meth meth skill'
      'visual notes notes';
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-1);
  }

  /* 层叠感：方法论在最前 */
  .research-board > :global([data-note='meth']) { z-index: 3; }
  .research-board > :global([data-note='obs']) { z-index: 2; margin-top: var(--sp-3); }
  .research-board > :global([data-note='skill']) { z-index: 1; margin-bottom: var(--sp-2); }
  .research-board > :global([data-note='visual']) { z-index: 2; margin-top: var(--sp-1); }
  .research-board > :global([data-note='notes']) { z-index: 1; }

  /* ---------- Desk（正在沉淀 + 精选） ---------- */
  .desk {
    display: grid;
    grid-template-columns: 30fr 70fr;
    gap: var(--sp-6);
    padding-top: var(--sp-6);
    scroll-margin-top: 80px;
  }

  .focus-title,
  .featured-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    margin: var(--sp-1) 0 var(--sp-3);
  }

  .focus-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .focus-item {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    gap: var(--sp-1);
    padding: var(--sp-2) 0;
    border-top: 1px solid var(--line-soft);
  }

  .focus-item:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  .focus-num {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--gold);
    letter-spacing: .08em;
    padding-top: .25em;
  }

  .focus-name {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: .2em;
  }

  .focus-q {
    font-size: var(--fs-small);
    color: var(--text-2);
    line-height: 1.6;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 62fr 38fr;
    gap: var(--sp-3);
    align-items: stretch;
  }

  .feat {
    display: flex;
    flex-direction: column;
    color: var(--ink);
    overflow: hidden;
  }

  .feat--primary .feat-figure {
    background: var(--paper-white);
    border-bottom: 1px solid var(--line-soft);
    padding: var(--sp-3);
    aspect-ratio: 16 / 8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feat--primary .feat-figure img {
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }

  .feat-body {
    padding: var(--sp-3) var(--sp-4) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .feat-side {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .feat--secondary {
    padding: var(--sp-3);
    gap: var(--sp-1);
    flex: 1;
  }

  .feat-kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    letter-spacing: .1em;
    color: var(--gold);
  }

  .feat-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.35;
    font-weight: 700;
  }

  .feat--primary .feat-name {
    font-size: 1.55rem;
  }

  .feat-summary {
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--text-2);
  }

  .feat-more {
    margin-top: auto;
    padding-top: var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-3);
    transition: color var(--dur-fast);
  }

  .feat:hover .feat-more {
    color: var(--gold);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .hero-grid { grid-template-columns: 46fr 54fr; gap: var(--sp-4); }
    .research-board { gap: var(--sp-2); }
  }

  @media (max-width: 900px) {
    .desk { grid-template-columns: 1fr; gap: var(--sp-4); }
    .featured-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 767px) {
    .hero { min-height: 0; padding: var(--sp-4) 0 var(--sp-3); }
    .hero-grid { grid-template-columns: 1fr; gap: var(--sp-3); }
    .hero-title { font-size: 2.2rem; }
    .hero-hand { display: none; }
    .hero-photo img { object-position: 60% 30%; opacity: .55; }

    /* 便签改横向 rail */
    .research-board {
      display: flex;
      gap: var(--sp-2);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding: var(--sp-2) 0 var(--sp-1);
      margin: 0 calc(-1 * var(--sp-2));
      padding-left: var(--sp-2);
    }
    .research-board::-webkit-scrollbar { display: none; }
    .research-board > :global(.archive-note) {
      flex: 0 0 78vw;
      scroll-snap-align: start;
      margin: 0 !important;
      grid-area: auto !important;
    }
    .research-board > :global(.archive-note:last-child) { margin-right: var(--sp-2) !important; }
  }
</style>
