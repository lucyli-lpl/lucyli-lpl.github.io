---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ListRow from '../../components/ListRow.astro';

const allPatterns = await getCollection('patterns');
const patterns = allPatterns.sort((a, b) => b.data.heat - a.data.heat);
---

<Base title="Pattern 追踪">
  <div class="container-wide">
    <PageHeader
      kicker="PATTERNS"
      title="Pattern 追踪"
      subtitle="追踪 AI 产品设计模式的演化，从概念到落地"
      meta={[`${patterns.length} 个 pattern`]}
    />

    <div class="filter-bar">
      <button class="filter-btn active" data-status="all">全部</button>
      <button class="filter-btn" data-status="evolving">进化中</button>
      <button class="filter-btn" data-status="converging">趋同期</button>
      <button class="filter-btn" data-status="landed">已落地</button>
      <button class="filter-btn" data-status="concept">概念期</button>
    </div>

    <div class="pattern-list">
      {patterns.map(p => (
        <div data-status={p.data.status}>
          <ListRow
            name={p.data.pattern_name}
            chineseName={p.data.chinese_name}
            status={p.data.status}
            heat={p.data.heat}
            firstSeen={p.data.first_seen}
            href={`/patterns/${p.id}/`}
            tags={p.data.tags}
          />
        </div>
      ))}
    </div>
  </div>
</Base>

<style>
  .filter-bar {
    display: flex;
    gap: 0.5em;
    margin-bottom: var(--sp-3);
    flex-wrap: wrap;
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    padding: 4px 12px;
    border: 1px solid var(--gray-300);
    border-radius: var(--radius);
    background: none;
    color: var(--gray-500);
    cursor: pointer;
    transition: all 0.1s;
  }

  .filter-btn:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .filter-btn.active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
</style>

<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.pattern-list > div');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const status = btn.getAttribute('data-status');
      items.forEach(item => {
        if (status === 'all' || item.getAttribute('data-status') === status) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
