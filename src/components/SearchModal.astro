<div id="search-modal" class="search-modal" hidden>
  <div class="search-overlay" data-close></div>
  <div class="search-dialog">
    <div id="search-container"></div>
  </div>
</div>

<script>
  const modal = document.getElementById('search-modal');
  const trigger = document.querySelector('.search-trigger');

  function openSearch() {
    modal?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    const input = modal?.querySelector('input');
    if (input) input.focus();
  }

  function closeSearch() {
    modal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  trigger?.addEventListener('click', async () => {
    if (!window.__pagefind) {
      const pfPath = '/pagefind/pagefind-ui.js';
      const pf = await import(/* @vite-ignore */ pfPath);
      new pf.PagefindUI({
        element: '#search-container',
        showSubResults: true,
        showImages: false,
      });
      window.__pagefind = true;
    }
    openSearch();
  });

  modal?.querySelector('[data-close]')?.addEventListener('click', closeSearch);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      trigger?.click();
    }
  });
</script>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
  }

  .search-modal[hidden] {
    display: none;
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
  }

  .search-dialog {
    position: relative;
    background: var(--paper);
    border-radius: var(--radius);
    width: 90%;
    max-width: 600px;
    max-height: 70vh;
    overflow-y: auto;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
</style>

<style is:global>
  .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--gray-100);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: var(--font-body);
  }
</style>
