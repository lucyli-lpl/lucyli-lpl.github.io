<div id="search-modal" class="search-modal" hidden>
  <div class="search-overlay" data-close></div>
  <div class="search-dialog">
    <div id="search-container"></div>
  </div>
</div>

<script>
  const modal = document.getElementById('search-modal');
  const trigger = document.querySelector('.search-trigger');

  function openSearch() {
    modal?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    const input = modal?.querySelector('input');
    if (input) input.focus();
  }

  function closeSearch() {
    modal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  // pagefind-ui.js 是挂在 window 上的传统脚本，不是 ES module，不能用 import()
  function loadPagefind(): Promise<void> {
    if ((window as any).PagefindUI) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);
      const s = document.createElement('script');
      s.src = '/pagefind/pagefind-ui.js';
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('pagefind-ui.js failed to load'));
      document.head.appendChild(s);
    });
  }

  let initialized = false;
  trigger?.addEventListener('click', async () => {
    openSearch();
    if (initialized) return;
    try {
      await loadPagefind();
      new (window as any).PagefindUI({
        element: '#search-container',
        showSubResults: true,
        showImages: false,
        translations: { placeholder: '搜索方法论、pattern、复盘…', zero_results: '没有找到「[SEARCH_TERM]」' },
      });
      initialized = true;
      modal?.querySelector('input')?.focus();
    } catch (err) {
      const c = document.getElementById('search-container');
      if (c) c.textContent = '搜索索引加载失败（本地 dev 模式下没有索引，需 build 后使用）';
      console.error(err);
    }
  });

  modal?.querySelector('[data-close]')?.addEventListener('click', closeSearch);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      trigger?.click();
    }
  });
</script>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
  }

  .search-modal[hidden] {
    display: none;
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
  }

  .search-dialog {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: 90%;
    max-width: 640px;
    max-height: 70vh;
    overflow-y: auto;
    padding: var(--sp-3) var(--sp-4);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }

  @media (max-width: 640px) {
    .search-dialog {
      padding: var(--sp-2);
    }
  }
</style>

<style is:global>
  .pagefind-ui {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--gray-100);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: var(--font-body);
  }

  /* 让结果区更松一点，和站点其他卡片的节奏一致 */
  .pagefind-ui__search-input {
    font-family: var(--font-body);
    font-weight: 400;
  }

  .pagefind-ui__message {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--gray-500);
    padding: var(--sp-1) 0;
  }

  .pagefind-ui__result {
    padding: var(--sp-2) 0;
    border-top: 1px solid var(--gray-200);
  }

  .pagefind-ui__result-title {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .pagefind-ui__result-excerpt {
    line-height: var(--lh-body);
    color: var(--gray-700);
  }

  .pagefind-ui__result-nested {
    padding-left: var(--sp-2);
    margin-top: var(--sp-1);
  }

  .pagefind-ui__result-tag {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
  }
</style>
