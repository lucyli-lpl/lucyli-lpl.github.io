---
interface Props {
  order: string;
  title: string;
  oneLiner?: string;
  chapterCount: number;
  skills?: string[];
  href: string;
}

const { order, title, oneLiner, chapterCount, skills = [], href } = Astro.props;
---

<a href={href} class="card-module">
  <div class="card-top">
    <span class="module-order">{order}</span>
    <h3 class="module-title">{title}</h3>
  </div>
  {oneLiner && <p class="module-liner">{oneLiner}</p>}
  <p class="module-meta">
    {chapterCount} 章{skills.length > 0 && ` · ${skills.length} 个关联 skill`}
  </p>
</a>

<style>
  .card-module {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--sp-3);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.1s;
  }

  .card-module:hover {
    border-color: var(--ink);
  }

  .card-top {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    margin-bottom: var(--sp-1);
  }

  .module-order {
    font-family: var(--font-mono);
    font-size: var(--fs-h2);
    font-weight: 500;
    color: var(--gray-500);
  }

  .module-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
  }

  .module-liner {
    font-size: var(--fs-meta);
    color: var(--gray-700);
    margin-bottom: var(--sp-1);
  }

  .module-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--gray-500);
  }
</style>
