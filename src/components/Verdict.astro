---
/**
 * 唯一的实色墨蓝块：只用于真判断（品鉴 verdict / 关键结论）。
 */
interface Props {
  text: string;
  label?: string;
}

const { text, label = 'VERDICT' } = Astro.props;
---

<div class="verdict">
  <span class="verdict-label">{label}</span>
  <p>{text}</p>
</div>

<style>
  .verdict {
    background: var(--ink);
    color: var(--paper-white);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--radius-lg);
    margin: var(--sp-3) 0 var(--sp-4);
  }

  .verdict-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    letter-spacing: .12em;
    color: var(--gold-soft);
    margin-bottom: var(--sp-1);
  }

  .verdict p {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.7;
  }
</style>
