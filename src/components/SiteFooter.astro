<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: var(--sp-3) 0;
    margin-top: var(--sp-8);
  }

  .footer-inner {
    max-width: var(--w-wide);
    margin: 0 auto;
    padding: 0 var(--sp-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .footer-copy {
    font-size: var(--fs-meta);
    color: var(--gray-500);
  }

  .footer-links {
    display: flex;
    gap: var(--sp-2);
  }

  .footer-links a {
    font-size: var(--fs-meta);
    color: var(--gray-500);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--ink);
  }
</style>
