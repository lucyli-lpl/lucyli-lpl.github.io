---
/**
 * 旧 API 的页头，样式对齐 ArticleHeader；新页面请直接用 ArticleHeader / SectionIntro。
 */
interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  meta?: string[];
}

const { kicker, title, subtitle, meta = [] } = Astro.props;
const metaItems = meta.filter(Boolean);
---

<div class="page-header">
  {kicker && <p class="section-num">{kicker}</p>}
  <h1>{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  {metaItems.length > 0 && <p class="meta-row">{metaItems.join(' · ')}</p>}
</div>

<style>
  .page-header {
    padding: var(--sp-4) 0 var(--sp-3);
    margin-bottom: var(--sp-4);
    border-bottom: 1px solid var(--line-soft);
  }

  .section-num { margin-bottom: var(--sp-1); }

  h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: var(--sp-2);
  }

  .subtitle {
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--text-2);
    max-width: 60ch;
    margin-bottom: var(--sp-1);
  }

  .meta-row {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-3);
  }
</style>
