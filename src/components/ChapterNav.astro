---
/**
 * 章节目录：桌面 sticky（top 96px），当前项 2px 蓝色指示；
 * 平板/移动端折叠为原生 <details>。
 */
interface Heading {
  slug: string;
  text: string;
  depth: number;
}

interface Props {
  headings: Heading[];
  title?: string;
}

const { headings, title = '目录' } = Astro.props;
---

<details class="chapter-nav" data-chapter-nav open>
  <summary class="chapter-nav-title">{title}</summary>
  <ul>
    {headings.map(h => (
      <li class:list={[{ sub: h.depth > 2 }]}>
        <a href={`#${h.slug}`}>{h.text}</a>
      </li>
    ))}
  </ul>
</details>

<script>
  function initChapterNav() {
    const nav = document.querySelector<HTMLDetailsElement>('[data-chapter-nav]:not([data-bound])');
    if (!nav) return;
    nav.dataset.bound = '1';

    // 小屏默认收起
    const mq = matchMedia('(max-width: 900px)');
    const sync = () => { nav.open = !mq.matches; };
    sync();
    mq.addEventListener('change', sync);

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
    const targets = links
      .map(a => document.getElementById(a.getAttribute('href')?.slice(1) ?? ''))
      .filter((el): el is HTMLElement => !!el);
    if (!targets.length) return;

    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        nav.querySelectorAll('li').forEach(li => li.classList.remove('active'));
        nav.querySelector(`a[href="#${en.target.id}"]`)?.parentElement?.classList.add('active');
      }
    }, { rootMargin: '-96px 0px -60% 0px' });
    targets.forEach(t => io.observe(t));
  }
  initChapterNav();
  document.addEventListener('astro:page-load', initChapterNav);
</script>

<style>
  .chapter-nav {
    position: sticky;
    top: 96px;
    font-size: var(--fs-meta);
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .chapter-nav-title {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: var(--sp-1);
    list-style: none;
    cursor: default;
  }

  .chapter-nav-title::-webkit-details-marker { display: none; }

  ul {
    list-style: none;
    padding: 0;
  }

  li {
    border-left: 2px solid var(--line-soft);
    padding: .3em 0 .3em .75em;
  }

  li.sub {
    padding-left: calc(.75em + var(--sp-2));
  }

  li.active {
    border-left-color: var(--blue);
  }

  a {
    color: var(--text-3);
    transition: color var(--dur-fast);
  }

  a:hover, li.active a {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .chapter-nav {
      position: static;
      max-height: none;
      border: 1px solid var(--line-soft);
      border-radius: var(--radius);
      padding: var(--sp-2);
      margin-bottom: var(--sp-3);
      background: var(--paper-white);
    }
    .chapter-nav-title {
      cursor: pointer;
      margin-bottom: 0;
      display: flex;
      justify-content: space-between;
    }
    .chapter-nav-title::after { content: '+'; color: var(--gold); }
    .chapter-nav[open] .chapter-nav-title::after { content: '−'; }
    .chapter-nav[open] .chapter-nav-title { margin-bottom: var(--sp-1); }
  }
</style>
