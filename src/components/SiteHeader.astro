---
import { nav, siteTitle } from '../../site.config';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="site-header" data-site-header>
  <div class="header-inner">
    <a href="/" class="site-logo" aria-label={`${siteTitle} 首页`}>{siteTitle}</a>

    <nav class="site-nav" aria-label="主导航">
      {nav.map(item => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="search-trigger" aria-label="检索档案" type="button">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="search-text">检索</span>
        <kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
      </button>
      <a href="https://github.com/lucyli-lpl" class="github-link" aria-label="GitHub" target="_blank" rel="noopener">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <button class="menu-toggle" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="移动端导航" class="mobile-nav">
      {nav.map((item, i) => (
        <a
          href={item.href}
          class:list={['mobile-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="mobile-num">{String(i + 1).padStart(2, '0')}</span>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.bound) return;
    header.dataset.bound = '1';

    // 滚动后加深材质
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // 移动端全宽菜单
    const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = header.querySelector<HTMLElement>('#mobile-menu');
    const setOpen = (open: boolean) => {
      if (!toggle || !menu) return;
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle?.addEventListener('click', () => setOpen(menu?.hidden ?? true));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    document.addEventListener('astro:before-swap', () => setOpen(false));
  }
  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    border-bottom: 1px solid transparent;
    transition: background var(--dur-base) var(--ease-soft), border-color var(--dur-base) var(--ease-soft);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header {
      -webkit-backdrop-filter: blur(12px) saturate(.9);
      backdrop-filter: blur(12px) saturate(.9);
    }
    .site-header.is-scrolled {
      -webkit-backdrop-filter: blur(16px) saturate(.9);
      backdrop-filter: blur(16px) saturate(.9);
    }
  }

  .site-header.is-scrolled {
    background: var(--header-bg-hi);
    border-bottom-color: var(--line-soft);
  }

  .header-inner {
    max-width: var(--w-hero);
    margin: 0 auto;
    padding: 0 var(--sp-3);
    height: 64px;
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .site-logo {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-body);
    letter-spacing: .02em;
    color: var(--ink);
    flex-shrink: 0;
  }

  .site-nav {
    display: flex;
    gap: var(--sp-3);
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    position: relative;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-body);
    color: var(--text-2);
    padding: 6px 2px;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  /* 当前项：墨蓝文字 + 4px 金点（design.md 6.1，二选一，选点） */
  .nav-link.active {
    color: var(--ink);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold);
    transform: translateX(-50%);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    flex-shrink: 0;
  }

  .search-trigger {
    display: flex;
    align-items: center;
    gap: .45em;
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--text-2);
    padding: .35em .6em;
    border-radius: var(--radius);
    transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
  }

  .search-trigger:hover {
    color: var(--ink);
    border-color: var(--silver-light);
    background: var(--paper-white);
  }

  .search-kbd {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--text-3);
    border: 1px solid var(--silver-light);
    border-radius: 3px;
    padding: 0 .35em;
    line-height: 1.5;
  }

  .github-link {
    color: var(--text-3);
    display: flex;
    padding: .35em;
    border-radius: var(--radius);
  }

  .github-link:hover {
    color: var(--ink);
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink);
    padding: .35em;
  }

  /* ---------- Mobile sheet ---------- */
  /* 全宽 sheet：不透明纸白（header 已有 backdrop-filter，子元素再叠 blur 不生效） */
  .mobile-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 64px;
    background: var(--paper-white);
    border-bottom: 1px solid var(--line-soft);
    box-shadow: var(--shadow-lift);
    padding: var(--sp-2) var(--sp-3) var(--sp-3);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-link {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    padding: var(--sp-2) 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--ink);
    border-bottom: 1px solid var(--line-soft);
  }

  .mobile-link:last-child {
    border-bottom: 0;
  }

  .mobile-num {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--gold);
    letter-spacing: .1em;
  }

  .mobile-link.active .mobile-num {
    color: var(--ink);
  }

  @media (max-width: 767px) {
    .header-inner { padding: 0 var(--sp-2); height: 56px; gap: var(--sp-2); }
    .site-nav { display: none; }
    .search-text, .search-kbd { display: none; }
    .search-trigger { border-color: transparent; padding: .45em; }
    .menu-toggle { display: flex; }
    .mobile-menu { top: 56px; }
  }
</style>
