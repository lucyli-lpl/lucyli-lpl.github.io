---
/**
 * 模块 × 版本 演化矩阵
 * 行 = 方法论模块，列 = 版本；格子亮起表示该版本改动了该模块。
 * 列头挂触发源标记（项目复盘 / 精读 / 讨论 / 自我梳理）。
 * 纯 HTML + CSS，无客户端 JS。
 */
import { TRIGGER_META, type ChangelogEntry } from '../lib/changelog';

interface ModuleRef {
  id: string;
  order: number;
  title: string;
}

interface Props {
  modules: ModuleRef[];
  entries: ChangelogEntry[];
}

const { modules, entries } = Astro.props;

const rows = [...modules].sort((a, b) => a.order - b.order).map(m => ({
  ...m,
  hits: entries.map(e => e.modules.includes(m.order)),
  count: entries.filter(e => e.modules.includes(m.order)).length,
}));

const maxCount = Math.max(1, ...rows.map(r => r.count));
const cols = entries.length;
---

{cols === 0 ? null : (
<section class="evo" aria-label="方法论演化矩阵">
  <div class="evo-head">
    <p class="evo-kicker">EVOLUTION · v{entries[0].version} → v{entries[cols - 1].version}</p>
    <h2 class="evo-title">模块 × 版本演化图</h2>
    <p class="evo-sub">每一格代表某个版本对某个模块的一次修订。列上方的符号标出这次修订由什么触发。</p>
  </div>

  <div class="evo-scroll">
    <table class="evo-grid" style={`--cols:${cols}`}>
      <thead>
        <tr>
          <th class="evo-corner" scope="col"><span class="sr-only">模块</span></th>
          {entries.map(e => {
            const t = TRIGGER_META[e.trigger];
            return (
              <th scope="col" class="evo-col">
                <a href={`/methodology/changelog/#v${e.version}`} class="evo-col-link" title={`v${e.version} · ${t.label}：${e.summary}`}>
                  <span class={`evo-trigger evo-trigger--${e.trigger}`} aria-label={t.label}>{t.glyph}</span>
                  <span class="evo-ver">{e.version}</span>
                </a>
              </th>
            );
          })}
          <th scope="col" class="evo-count-head">修订</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(r => (
          <tr>
            <th scope="row" class="evo-row-head">
              <a href={`/methodology/${r.id}/`} class="evo-row-link">
                <span class="evo-order">{String(r.order).padStart(2, '0')}</span>
                <span class="evo-name">{r.title}</span>
              </a>
            </th>
            {r.hits.map((hit, i) => {
              const e = entries[i];
              return hit ? (
                <td class="evo-cell">
                  <a href={`/methodology/changelog/#v${e.version}`} class={`evo-dot evo-dot--${e.trigger}`} title={`v${e.version} · ${e.summary}`}>
                    <span class="sr-only">v{e.version} 修订了本模块</span>
                  </a>
                </td>
              ) : (
                <td class="evo-cell"><span class="evo-empty" aria-hidden="true" /></td>
              );
            })}
            <td class="evo-count">
              <span class="evo-bar" style={`--w:${r.count / maxCount}`} aria-hidden="true" />
              <span class="evo-num">{r.count}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <ul class="evo-legend" aria-label="触发源图例">
    {(Object.keys(TRIGGER_META) as (keyof typeof TRIGGER_META)[]).map(k => (
      <li>
        <span class={`evo-trigger evo-trigger--${k}`} aria-hidden="true">{TRIGGER_META[k].glyph}</span>
        {TRIGGER_META[k].label}
      </li>
    ))}
  </ul>
</section>
)}

<style>
  .evo {
    margin: var(--sp-6) 0;
  }

  .evo-head {
    margin-bottom: var(--sp-3);
  }

  .evo-kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--gray-500);
    letter-spacing: 0.08em;
    margin-bottom: var(--sp-1);
  }

  .evo-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    margin-bottom: var(--sp-1);
  }

  .evo-sub {
    font-size: var(--fs-meta);
    color: var(--gray-700);
    max-width: var(--w-prose);
  }

  .evo-scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--paper);
  }

  .evo-grid {
    border-collapse: collapse;
    width: 100%;
    min-width: calc(220px + var(--cols) * 44px + 96px);
    font-size: var(--fs-meta);
  }

  .evo-grid th,
  .evo-grid td {
    padding: 0;
    border-bottom: 1px solid var(--gray-200);
  }

  .evo-grid tbody tr:last-child th,
  .evo-grid tbody tr:last-child td {
    border-bottom: none;
  }

  /* 列头 */
  .evo-corner,
  .evo-col,
  .evo-count-head {
    background: var(--paper-2);
    border-bottom: 1px solid var(--border);
    height: 56px;
    vertical-align: bottom;
  }

  .evo-count-head {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--gray-500);
    text-align: left;
    padding: 0 var(--sp-2) var(--sp-1);
  }

  .evo-col-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: var(--sp-1) 0;
    text-decoration: none;
    color: var(--ink);
  }

  .evo-col-link:hover .evo-ver {
    text-decoration: underline;
  }

  .evo-ver {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--gray-700);
  }

  /* 触发源符号 */
  .evo-trigger {
    font-size: 0.7rem;
    line-height: 1;
  }

  .evo-trigger--project    { color: var(--warm); }
  .evo-trigger--reading    { color: var(--accent); }
  .evo-trigger--discussion { color: var(--green); }
  .evo-trigger--internal   { color: var(--gray-500); }

  /* 行头 */
  .evo-row-head {
    text-align: left;
    font-weight: 400;
    width: 220px;
    background: var(--paper);
    position: sticky;
    left: 0;
    z-index: 1;
    border-right: 1px solid var(--border);
  }

  .evo-row-link {
    display: flex;
    align-items: baseline;
    gap: var(--sp-1);
    padding: 10px var(--sp-2);
    text-decoration: none;
    color: var(--ink);
  }

  .evo-row-link:hover .evo-name {
    text-decoration: underline;
  }

  .evo-order {
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--gray-500);
  }

  .evo-name {
    font-size: var(--fs-meta);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 170px;
  }

  /* 格子 */
  .evo-cell {
    text-align: center;
    width: 44px;
    height: 40px;
  }

  .evo-empty {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gray-200);
  }

  .evo-dot {
    display: inline-block;
    width: 18px;
    height: 18px;
    border-radius: 3px;
    transition: transform 0.1s;
  }

  .evo-dot:hover {
    transform: scale(1.25);
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }

  .evo-dot--project    { background: var(--warm); }
  .evo-dot--reading    { background: var(--accent); }
  .evo-dot--discussion { background: var(--green); }
  .evo-dot--internal   { background: var(--gray-500); }

  /* 修订次数 */
  .evo-count {
    padding: 0 var(--sp-2);
    white-space: nowrap;
    width: 96px;
  }

  .evo-bar {
    display: inline-block;
    vertical-align: middle;
    height: 8px;
    width: calc(var(--w) * 48px);
    min-width: 2px;
    background: var(--ink);
    border-radius: 2px;
    margin-right: var(--sp-1);
  }

  .evo-num {
    font-family: var(--font-mono);
    color: var(--gray-700);
    vertical-align: middle;
  }

  /* 图例 */
  .evo-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    list-style: none;
    padding: 0;
    margin: var(--sp-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-tag);
    color: var(--gray-700);
  }

  .evo-legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
