---
/**
 * 首页研究板上的一张档案便签：icon / 标题 / 两行说明 / 角落箭头。
 * 玻璃材质，hover/focus 抬起；细指针设备上由页面脚本加 ≤2deg tilt。
 */
interface Props {
  title: string;
  sub?: string;
  desc: string;
  href: string;
  icon: 'book' | 'eye' | 'drawer' | 'swatch' | 'pen';
  size?: 'lg' | 'md';
  rotate?: number;
  area?: string;
}

const { title, sub, desc, href, icon, size = 'md', rotate = 0, area } = Astro.props;

const icons: Record<Props['icon'], string> = {
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5V5.5"/><path d="M8 7h8M8 11h8"/>',
  eye: '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  drawer: '<rect x="3" y="4" width="18" height="7" rx="1"/><rect x="3" y="13" width="18" height="7" rx="1"/><path d="M10 7.5h4M10 16.5h4"/>',
  swatch: '<rect x="3" y="3" width="8" height="18" rx="1"/><path d="M11 6l7 4-7 11"/><path d="M21 21H3"/>',
  pen: '<path d="M4 20l4-1 11-11-3-3L5 16z"/><path d="M13 6l3 3"/>',
};
---

<a
  href={href}
  class:list={['archive-note', 'glass', 'lift', `archive-note--${size}`]}
  style={`--rot:${rotate}deg;${area ? `grid-area:${area};` : ''}`}
  data-note={area}
  data-tilt
>
  <span class="note-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} />
  </span>
  <span class="note-head">
    <span class="note-title">{title}</span>
    {sub && <span class="note-sub">{sub}</span>}
  </span>
  <span class="note-desc">{desc}</span>
  <span class="note-arrow" aria-hidden="true">→</span>
  <span class="note-clip" aria-hidden="true" />
</a>

<style>
  .archive-note {
    --tx: 0deg;
    --ty: 0deg;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-3);
    color: var(--ink);
    transform: rotate(var(--rot)) rotateX(var(--tx)) rotateY(var(--ty));
    min-height: 168px;
  }

  .archive-note--lg {
    min-height: 200px;
    padding: var(--sp-4);
  }

  .archive-note:hover,
  .archive-note:focus-visible {
    transform: rotate(var(--rot)) rotateX(var(--tx)) rotateY(var(--ty)) translateY(-6px);
    border-color: var(--silver);
  }

  .note-icon {
    width: 30px;
    height: 30px;
    color: var(--ink-2);
  }

  .archive-note--lg .note-icon {
    width: 38px;
    height: 38px;
  }

  .note-icon svg {
    width: 100%;
    height: 100%;
  }

  .note-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-1);
    flex-wrap: wrap;
    margin-top: auto;
  }

  .note-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .archive-note--lg .note-title {
    font-size: 1.8rem;
  }

  .note-sub {
    font-family: var(--font-hand);
    font-size: 1.1rem;
    color: var(--ink-3);
  }

  .note-desc {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--text-2);
    max-width: 30ch;
  }

  .note-arrow {
    position: absolute;
    right: var(--sp-3);
    bottom: var(--sp-2);
    font-family: var(--font-mono);
    color: var(--text-3);
    transition: transform var(--dur-fast) var(--ease-standard), color var(--dur-fast);
  }

  .archive-note:hover .note-arrow,
  .archive-note:focus-visible .note-arrow {
    transform: translateX(4px);
    color: var(--gold);
  }

  /* 银色夹子 */
  .note-clip {
    position: absolute;
    top: -7px;
    left: 22px;
    width: 26px;
    height: 13px;
    border: 2px solid var(--silver-dark);
    border-bottom: 0;
    border-radius: 13px 13px 0 0;
    opacity: .85;
  }

  @media (max-width: 767px) {
    .archive-note,
    .archive-note--lg {
      min-height: 160px;
      padding: var(--sp-3);
      transform: none;
    }
    .archive-note--lg .note-title { font-size: 1.4rem; }
  }
</style>
