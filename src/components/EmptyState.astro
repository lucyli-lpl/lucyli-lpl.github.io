---
/**
 * 空档案抽屉：不是"敬请期待"，是"正在整理"。
 */
interface Props {
  title: string;
  description?: string;
}

const { title, description = '正在整理' } = Astro.props;
---

<div class="empty-state">
  <span class="section-num">EMPTY DRAWER</span>
  <h2>{title}</h2>
  <p>{description}</p>
</div>

<style>
  .empty-state {
    border: 1px dashed var(--silver);
    border-radius: var(--radius-lg);
    padding: var(--sp-6) var(--sp-4);
    text-align: center;
    background: var(--paper-white);
  }

  .section-num {
    display: block;
    margin-bottom: var(--sp-1);
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    margin-bottom: var(--sp-1);
  }

  p {
    color: var(--text-3);
    font-size: var(--fs-meta);
  }
</style>
